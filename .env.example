# Canonical JARVIS environment-variable reference.
# Copy selected values into your process environment or local secret manager.
# JARVIS does not automatically read this file. Never commit populated secrets.

# JARVIS_CONFIG_FILE=C:\path\to\config.toml

JARVIS_AI_ENABLED=false
JARVIS_AI_PROVIDER=openai-compatible
JARVIS_AI_MODEL=
JARVIS_AI_API_KEY=
# JARVIS_AI_BASE_URL=https://api.openai.com/v1
JARVIS_AI_TIMEOUT_SECONDS=30

JARVIS_VISION_ENABLED=false
JARVIS_VISION_PROVIDER=openai-compatible
JARVIS_VISION_MODEL=
JARVIS_VISION_API_KEY=
# JARVIS_VISION_BASE_URL=https://api.openai.com/v1
JARVIS_VISION_TIMEOUT_SECONDS=30

JARVIS_VOICE_ENABLED=false
JARVIS_VOICE_TTS_ENABLED=false
JARVIS_VOICE_STT_PROVIDER=none
JARVIS_VOICE_TTS_PROVIDER=none
JARVIS_VOICE_LANGUAGE=en-US

JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_AUTO_SAVE=false
JARVIS_MEMORY_PERSIST_CONVERSATIONS=false
JARVIS_MEMORY_ALLOW_SENSITIVE=false
JARVIS_DATABASE_PATH=~/.jarvis/jarvis.db

JARVIS_LOGGING_LEVEL=INFO
# JARVIS_LOGGING_FILE=~/.jarvis/jarvis.log

JARVIS_PERMISSIONS_READ=allow
JARVIS_PERMISSIONS_ACTION=ask
JARVIS_PERMISSIONS_SENSITIVE=ask
JARVIS_PERMISSIONS_DESTRUCTIVE=ask

JARVIS_SCREENSHOTS_DIRECTORY=~/.jarvis/screenshots
JARVIS_SCREENSHOTS_KEEP_TEMPORARY=false

JARVIS_BROWSER_ENABLED=false
JARVIS_BROWSER_TYPE=chromium
JARVIS_BROWSER_HEADLESS=true
JARVIS_BROWSER_PROFILE=ephemeral
JARVIS_BROWSER_MAX_SESSIONS=2
JARVIS_BROWSER_MAX_TABS=8

JARVIS_SCHEDULER_ENABLED=true
JARVIS_SCHEDULER_DATABASE_PATH=~/.jarvis/tasks.db
JARVIS_SCHEDULER_TIMEZONE=UTC
JARVIS_SCHEDULER_POLL_INTERVAL_SECONDS=30
JARVIS_SCHEDULER_DESKTOP_NOTIFICATIONS=false

JARVIS_GITHUB_ENABLED=false
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_BASE_URL=https://api.github.com
JARVIS_EMAIL_PROVIDER=none
JARVIS_CALENDAR_PROVIDER=none

JARVIS_PLUGINS_ENABLED=false
JARVIS_PLUGINS_AUTO_LOAD=false
JARVIS_PLUGINS_STATE_PATH=~/.jarvis/plugins.db

JARVIS_GUI_THEME=system
JARVIS_GUI_MINIMIZE_TO_TRAY=false
JARVIS_GUI_SHOW_DEBUG_LOGS=false
